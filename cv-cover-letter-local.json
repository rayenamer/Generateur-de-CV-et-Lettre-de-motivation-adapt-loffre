      "id": "local-resume",
      "name": "Local LLM - Resume JSON",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Works with Claude (bridge), Gemini and Ollama (local) responses\nconst res = $json;\nif (res.stop_reason === 'max_tokens' || res.finishReason === 'MAX_TOKENS' || res.done_reason === 'length') throw new Error('Model hit its max output tokens.');\n\nlet text = Array.isArray(res.content)\n  ? res.content.filter(b => b.type === 'text').map(b => b.text).join('')\n  : (res.content?.parts || []).map(p => p.text || '').join('') || res.message?.content || res.text || '';\ntext = text.replace(/```(?:json)?/gi, '').trim();\nconst match = text.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('Model did not return JSON: ' + text.slice(0, 300));\nconst data = JSON.parse(match[0]);\n\n// Escape LaTeX special characters in every string value\nconst map = {\n  '\\\\': '\\\\textbackslash{}', '&': '\\\\&', '%': '\\\\%', '$': '\\\\$',\n  '#': '\\\\#', '_': '\\\\_', '{': '\\\\{', '}': '\\\\}',\n  '~': '\\\\textasciitilde{}', '^': '\\\\textasciicircum{}',\n};\nconst esc = s => s.replace(/[\\\\&%$#_{}~^]/g, c => map[c]);\nconst walk = v =>\n  typeof v === 'string' ? esc(v)\n  : Array.isArray(v) ? v.map(walk)\n  : v && typeof v === 'object'\n    ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, walk(x)]))\n    : v;\n\ndata.PROFILE_SUMMARY = data.PROFILE_SUMMARY || data.summary || data.basics?.summary || '';\n\n// Plain-text keyword report sent to Telegram after the PDFs\nconst matched = data.ATS_MATCHED || [], missing = data.ATS_MISSING || [], added = data.ATS_ADDED || [];\nconst report = [\n  `ATS keywords covered: ${matched.length}/${matched.length + missing.length}`,\n  missing.length ? `Not in your profile: ${missing.join(', ')}` : 'Every keyword of the offer is covered.',\n  added.length ? `\\nAdded beyond your profile (prepare to talk about these in interviews):\\n- ${added.join('\\n- ')}` : ''\n].filter(Boolean).join('\\n');\n\nconst out = walk(data);\nout.ATS_REPORT = report;\nreturn { json: out };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2340,
