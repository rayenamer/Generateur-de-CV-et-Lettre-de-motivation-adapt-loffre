      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Build Prompts').item.json.resumeRequest.model, stream: false, format: 'json', options: { num_ctx: 8192, num_predict: 4096, temperature: 0.3 }, messages: [{ role: 'system', content: $('Build Prompts').item.json.resumeRequest.system }, ...$('Build Prompts').item.json.resumeRequest.messages] }) }}",
        "options": {
          "timeout": 1800000
