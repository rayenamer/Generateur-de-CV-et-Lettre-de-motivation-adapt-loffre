    {
      "parameters": {
        "jsCode": "// Take ONE offer per run. Everything up to it (short messages included) gets confirmed to Telegram.\nconst updates = $input.first().json.result || [];\nconst offer = updates.find(u => (u.message?.text || '').trim().length > 20);\nconst lastId = offer ? offer.update_id : Math.max(-1, ...updates.map(u => u.update_id));\nreturn [{ json: { hasOffer: !!offer, confirmOffset: lastId + 1, message: offer?.message || null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        16
      ],
      "id": "pick-offer",
      "name": "Pick Next Offer"
    },
    {
      "parameters": {
        "url": "https://api.telegram.org/botYOUR_TELEGRAM_BOT_TOKEN/getUpdates",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.confirmOffset }}"
            },
            {
              "name": "limit",
              "value": "1"
            },
            {
              "name": "timeout",
              "value": "0"
            }
          ]
        }
